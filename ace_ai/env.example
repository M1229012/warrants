# 艾斯 AI Discord Bot 環境變數範例（只列名稱與預設值，不要把真實 Secret 提交到 GitHub）

# ===== Discord（必填）=====
DISCORD_BOT_TOKEN=
# 允許使用的 Discord User ID，逗號分隔；填 * 代表不限使用者（只限伺服器內、不接受私訊）
# 未設定時所有人都會收到「尚未開放」
DISCORD_AI_ALLOWED_USER_IDS=*
# 可選：限制只能在這些頻道使用，逗號分隔；留空代表不限頻道
DISCORD_AI_ALLOWED_CHANNEL_IDS=
# 1 = console 顯示解析、路由、Tool 耗時、Gemini 次數等除錯資訊（不會送到 Discord）
DISCORD_AI_DEBUG=0

# Slash 指令 /ask：填伺服器 ID 會立即生效；留空為全域同步（最久約 1 小時）
DISCORD_AI_GUILD_IDS=
DISCORD_AI_SLASH_COMMAND=ask
# 管理員專用指令（本週精選、草稿、資料維護）；和 /ask 完全分開，避免草稿吃掉一般問題
DISCORD_AI_ADMIN_COMMAND=ace
# 1 = /ask 回覆只有自己看得到
DISCORD_AI_EPHEMERAL=0
# 本週精選：伺服器管理員（有「管理員」或「管理伺服器」權限）預設都可以用；0＝只限下面名單
DISCORD_AI_WEEKLY_PICK_ALLOW_ADMINS=1
# 額外可使用本週精選的 User ID（逗號分隔），伺服器管理員不用列
DISCORD_AI_WEEKLY_PICK_USER_IDS=
# 1 = 開啟 !ace 文字指令（需在 Developer Portal 開 Message Content Intent）；預設只用 /ask
DISCORD_AI_PREFIX_COMMAND_ENABLE=0

# ===== 盤中即時報價（富果；未設定 FUGLE_API_KEY 時只用日K）=====
FUGLE_API_KEY=
DISCORD_AI_INTRADAY_ENABLE=1
DISCORD_AI_TTL_INTRADAY_SECONDS=60
DISCORD_AI_FUGLE_TIMEOUT=6
# 盤中累計成交量單位：lots＝張（預設）、shares＝股；依啟動 Log「📏 富果成交量單位校正」決定
FUGLE_QUOTE_VOLUME_UNIT=lots
# 盤中量對近 20 日均量超過／低於這個倍數時標成可疑、不解讀量能
DISCORD_AI_VOLUME_SUSPECT_HIGH=30
DISCORD_AI_VOLUME_SUSPECT_LOW=0.001

# ===== 多人排隊與追問記憶（以下皆為預設值）=====
DISCORD_AI_ANSWER_CONCURRENCY=3
DISCORD_AI_QUEUE_LIMIT=20
DISCORD_AI_GEMINI_CONCURRENCY=2
DISCORD_AI_TOOL_WORKERS=10
DISCORD_AI_MEMORY_MINUTES=30
DISCORD_AI_MEMORY_MAX_ENTRIES=5000

# ===== 本週精選（以下皆為預設值）=====
WEEKLY_PICK_EVENT_WINDOW_DAYS=60
WEEKLY_PICK_MIN_EVENT_WIN_RATE=60
WEEKLY_PICK_MIN_EVENT_SAMPLE=10
WEEKLY_PICK_SHORTLIST_SIZE=0
WEEKLY_PICK_TOP_N=10
WEEKLY_PICK_RECENT_BEHAVIOR_DAYS=30
WEEKLY_PICK_RECENT_CASE_COUNT=10
WEEKLY_PICK_WORKERS=3
WEEKLY_PICK_CACHE_SECONDS=43200
# 本週精選排除的股票代號，逗號分隔
WEEKLY_PICK_EXCLUDE_CODES=2330
# 權證淨買超排行：統計範圍（全分點／精選五分點）與顯示名次數
DISCORD_AI_TOP15_SCOPE=全分點
DISCORD_AI_TOP_WARRANT_LIMIT=5
# 勝負平手區間（%）；0＝與目前回測相同（>0 勝、<0 敗）。回測日後若改規則，這裡要設成一樣
WINRATE_FLAT_BAND_PCT=0
# 小樣本修正強度（Bayesian prior strength）
DISCORD_AI_EVENT_PRIOR_STRENGTH=20

# ===== 沿用週報既有 Secret =====
WARRANTS_API_KEY=
WARRANTS_API_KEY_2=
WARRANTS_API_KEY_3=
GEMINI_MODEL=gemini-3.1-flash-lite
FINMIND_API_TOKEN=
# 服務帳號 JSON 全文；該服務帳號必須能讀取「權證分點資料_NEW_MoneyDJ」
GCP_SERVICE_KEY=
GSHEET_NAME=權證分點資料_NEW_MoneyDJ
# 可選：直接指定試算表 ID（與回測的 GOOGLE_SHEET_ID_MONEYDJ 相同），避免同名檔案開錯
GOOGLE_SHEET_ID=

# ===== 可選調整（以下皆為預設值）=====
DISCORD_AI_COMMAND_PREFIX=!ace
DISCORD_AI_USER_COOLDOWN_SECONDS=8
DISCORD_AI_ANSWER_CACHE_SECONDS=300
DISCORD_AI_TOOL_TIMEOUT_SECONDS=180
DISCORD_AI_PLANNER_ENABLE=1
DISCORD_AI_TTL_PRICE_SECONDS=600
DISCORD_AI_TTL_WARRANT_SECONDS=1200
DISCORD_AI_TTL_NEWS_SECONDS=2700
DISCORD_AI_TTL_SHEET_SECONDS=1800
DISCORD_AI_TTL_BRANCH_PERF_SECONDS=21600
DISCORD_AI_HIGH_WIN_RATE_PCT=60
DISCORD_AI_SMALL_SAMPLE_EVENTS=10
# 週報主程式檔名不是 K_function_warrant_report_20260530.py 時才需要設定
WARRANT_CORE_SCRIPT=

# 可選：自訂中文字型的絕對路徑；Docker 已安裝 Noto CJK
DISCORD_AI_FONT_PATH=

# ===== 記憶體與資料來源（Railway 預設值）=====
# 分點／權證問題與週精選一律以 Google Sheet 為主；MoneyDJ 只保留「管理員明確要求備援圖片」的路由。
# 下列舊旗標保留相容性，但不會讓一般會員路由自動切到 MoneyDJ。
DISCORD_AI_LIVE_FLOW_ENABLE=0
DISCORD_AI_MONEYDJ_TOP_ENABLE=0
WEEKLY_PICK_LIVE_FLOW_ENABLE=0

# 權證分點 K 線點位：一般模式從 Google Sheet 事件／賣出資料取得；管理員 MoneyDJ 備援才走即時流水。
WARRANT_FLOW_MAX_DAYS=60
CHART_FLOW_TOP_BRANCHES=4
CHART_FLOW_MIN_ABS_AMOUNT=100000
CHART_FLOW_MAX_MARKS=14
# K 線上最多標註幾筆分點買賣事件
DISCORD_AI_CHART_MARK_MAX_EVENTS=12
# 追蹤分點籌碼清單忽略小於這個金額的賣出紀錄
DISCORD_AI_SHEET_CHIPS_MIN_SELL_AMOUNT=100000
# 買進後幾個交易日內全部出清視為隔日沖，不在 K 線上標註
DISCORD_AI_DAYTRADE_MAX_HOLD_DAYS=2

# ===== 族群（詳見 SECTOR_README.md，以下皆為預設值）=====
DISCORD_AI_SECTOR_MEMBERS_TTL=86400
DISCORD_AI_SECTOR_RESULT_TTL=300
DISCORD_AI_SECTOR_TIMEOUT=90
DISCORD_AI_SECTOR_REQUEST_GAP=1.5
DISCORD_AI_FINE_MEMBERS_TTL=86400
DISCORD_AI_FINE_MEMBERS_TIMEOUT=12

# ===== 全市場日K底庫（證交所／櫃買官方每日行情，免金鑰；一個交易日 2 個請求）=====
# 1 = Bot 背景自動維護底庫（開機補歷史、每天收盤後補當天）
DISCORD_AI_MARKET_SYNC_ENABLE=1
# 要保留幾個交易日的歷史（畫 K 線與 MA60 需要；140 約等於 7 個月）
DISCORD_AI_MARKET_HISTORY_DAYS=140
DISCORD_AI_PATTERN_HISTORY_DAYS=150
# 每輪背景補資料／算型態分數的時間上限（秒）
DISCORD_AI_MARKET_SYNC_BUDGET=600
DISCORD_AI_MARKET_SCORE_BUDGET=240
# 官方行情請求間隔（秒）與逾時
DISCORD_AI_MARKET_REQUEST_GAP=1.2
DISCORD_AI_MARKET_HTTP_TIMEOUT=20

# ===== 全市場族群排行門檻 =====
# 一個族群至少要有幾檔達流動性門檻、且要有多少比例算得出數值，才會列入排行
DISCORD_AI_MARKET_MIN_MEMBERS=5
DISCORD_AI_MARKET_MIN_COVERAGE=0.6

# ===== 族群成分名冊（自建快照；平常查詢完全不連 CMoney）=====
# 名冊檔案位置；掛了 /data 就會優先用 /data/sector_roster.json
DISCORD_AI_SECTOR_ROSTER=
# 重建名冊時的並行連線數與逾時
DISCORD_AI_ROSTER_WORKERS=6
DISCORD_AI_ROSTER_TIMEOUT=15

# ===== 週精選草稿 =====
# 草稿編輯 session 保留幾分鐘（管理員常常改一改、去看盤、再回來改）
DISCORD_AI_WEEKLY_DRAFT_MINUTES=120

# ===== 權證分點查詢視窗 =====
# 個股權證分點預設看近 N 個交易日（和 K 線圖同一區間）；使用者說「近10日」時以指定天數為準
DISCORD_AI_CHIPS_DAYS=70

# 族群排行只列成交夠熱絡的個股：近 N 日平均成交金額（元）與平均成交量（張）都要達標
DISCORD_AI_SECTOR_LIQUIDITY_DAYS=20
DISCORD_AI_SECTOR_MIN_AVG_VALUE=50000000
DISCORD_AI_SECTOR_MIN_AVG_LOTS=500

# ===== v8：細族群、盤中型態、API 額度監控 =====
# 型態與日K持久化：建議 Railway 掛 Persistent Volume 到 /data（天數設定見上方「全市場日K底庫」）
DISCORD_AI_MARKET_CACHE_DB=/data/ace_ai_market_cache.sqlite3
# 盤中型態用「歷史 + 今日即時K」重算；圖片／文字須標盤中暫定
DISCORD_AI_LIVE_PATTERN_SCORE=1
# 13:30 後若 Fugle isClose 尚未成立：曾被查詢的股票至少每 15 分鐘可背景重查一次；
# 使用者再次查詢時，在 120 分鐘的查核視窗內也維持短快取重新確認。
DISCORD_AI_POST_CLOSE_RECHECK_MINUTES=15
DISCORD_AI_POST_CLOSE_QUERY_WINDOW_MINUTES=120
# Fugle Basic 60/min：背景工作最多 15/min，至少保留 20/min 給會員直接問答
DISCORD_AI_FUGLE_BACKGROUND_LIMIT_PER_MIN=15
DISCORD_AI_FUGLE_USER_RESERVE_PER_MIN=20
# CMoney 細產業／概念名冊與盤中族群雷達；名冊持久化於 /data
DISCORD_AI_CMONEY_CACHE=/data/cmoney_sector_catalog.json
DISCORD_AI_CMONEY_CATALOG_TTL=43200
DISCORD_AI_CMONEY_RADAR_TTL=300
DISCORD_AI_CMONEY_TIMEOUT=8
# Railway Log：每 5 分鐘印 API / RAM / CPU / Disk / session 統計；背景 tick 60 秒
DISCORD_AI_USAGE_LOG_SECONDS=300
DISCORD_AI_BACKGROUND_TICK_SECONDS=60
DISCORD_AI_FINMIND_USAGE_TTL=300
# Fugle 使用者查詢硬上限保護：官方 60/min，預設 55/min 避免併發誤撞 429
DISCORD_AI_FUGLE_HARD_LIMIT_PER_MIN=55
# CMoney 細族群成分股低頻背景補齊：每 60 秒最多 1 個族群；0 可關閉
DISCORD_AI_CMONEY_MEMBER_WARMUP_PER_TICK=1

# --- v15 新增 ---
# 富果備援金鑰（401/403/429 時自動換下一支）
FUGLE_API_KEY_2=
# 規則認不出問題時，花 1 次 Gemini 做主題分類（0＝關閉，只用規則＋反問）
DISCORD_AI_INTENT_FALLBACK=1
# Gemini 每日次數軟上限（0＝不限）；超過只出規則式內容
DISCORD_AI_GEMINI_DAILY_LIMIT=0
# Bot 行程要過濾掉的 log 關鍵字（用 | 分隔）
DISCORD_AI_LOG_MUTE=週報統計區間
# 盤中族群轉強／轉弱雷達
DISCORD_AI_RADAR_SNAPSHOT_MINUTES=5
DISCORD_AI_RADAR_COMPARE_MINUTES=30
DISCORD_AI_RADAR_TOP=5
DISCORD_AI_RADAR_MIN_MEMBERS=5
# 台指期未平倉的商品代碼
DISCORD_AI_FUTURES_ID=TX
