# Discord 正式會員由精確角色名稱判斷；/ace 僅限管理員或 SUPERUSER。
# 其他 SUPERUSER ID 請自行以逗號加入 Railway Variable。
DISCORD_AI_SUPERUSER_IDS=1084419868624961578
# Beta 功能測試者（逗號分隔 Discord ID）；SUPERUSER 與正常 /ace 自動擁有 Beta。
DISCORD_AI_BETA_TESTER_IDS=
# 管理員錯誤通知：私人頻道 ID（Bot 需要該頻道的查看／傳送訊息權限）；留空＝不通知。
DISCORD_AI_ALERT_CHANNEL_ID=
# 嚴重錯誤（程式例外、Gemini 全部失敗）要 @ 的 Discord 使用者 ID，逗號分隔；留空＝不 @。
DISCORD_AI_ALERT_MENTION_IDS=

# ===== 現股券商分點籌碼（SPOT_CHIP，以下皆為預設值，可不設）=====
# 目前正式 Docker 只支援 http（直接抓富邦 eBroker 分點頁）。Docker 沒有安裝 chromium／chromedriver／selenium，
# 設成 selenium 不會生效（程式記 Log 後自動改用 http）；要用 selenium 必須先改 Dockerfile 補齊這三項。
DISCORD_AI_SPOT_FETCHER=http
# 背景補歷史的 worker 數（固定執行緒池，不會每檔開新執行緒）；型態＋籌碼整合頁最多等幾秒補最近完整日
DISCORD_AI_SPOT_BACKGROUND_WORKERS=1
DISCORD_AI_SPOT_QUICK_BUDGET=8
# 全市場收盤：單一市場當天普通股少於門檻視為回應不完整（上市約 1,000 檔、上櫃約 800 檔）
DISCORD_AI_MARKET_MIN_ROWS_TWSE=500
DISCORD_AI_MARKET_MIN_ROWS_TPEX=300
# FinMind Token：授權失敗停用秒數、429／逾時／5xx 冷卻秒數
DISCORD_AI_FINMIND_AUTH_COOLDOWN=43200
DISCORD_AI_FINMIND_TRANSIENT_COOLDOWN=60
# 同時抓取的股票數、每頁間隔秒數、每題最多花幾秒補歷史（沒補完下次從中斷處繼續）
DISCORD_AI_SPOT_CONCURRENCY=1
DISCORD_AI_SPOT_REQUEST_GAP=0.2
DISCORD_AI_SPOT_BACKFILL_BUDGET=25
# 會員那一題時間用完後，背景繼續補歷史的時間上限（秒）
DISCORD_AI_SPOT_BACKGROUND_BUDGET=600
# 幾點後才嘗試抓「今天」的分點（之前一律顯示最近完整交易日）
DISCORD_AI_SPOT_TODAY_READY=15:30
# 一般現股籌碼題同步階段總秒數（先補最近完整日，剩下的時間並行補 70 日，補不完才背景）；單頁讀取逾時秒數
DISCORD_AI_SPOT_SYNC_BUDGET=10
# 會員這一題補歷史時並行幾條連線（本機實測 4 條：每頁 0.40→0.10 秒、未被擋）；1＝逐頁
DISCORD_AI_SPOT_PARALLEL=4
DISCORD_AI_SPOT_HTTP_TIMEOUT=10
# 背景補資料排隊上限（股票數）；來源連續失敗幾次停止本輪、之後暫停新抓取幾秒
DISCORD_AI_SPOT_MAX_PENDING_BACKFILLS=24
DISCORD_AI_SPOT_SOURCE_FAIL_LIMIT=3
DISCORD_AI_SPOT_SOURCE_COOLDOWN=45
# Gemini 單次呼叫總時限（秒，含重試與備援）；超過改用規則式內容。0＝不限
DISCORD_AI_GEMINI_DEADLINE_SECONDS=40
# 今日待抓：當天資料出來前被查過的股票（最多 N 檔），TODAY_READY 後富邦一更新就先抓當天那頁；每輪最多幾秒；0＝關閉
DISCORD_AI_SPOT_TODAY_PREFETCH_ENABLE=1
DISCORD_AI_SPOT_TODAY_QUEUE_MAX=300
DISCORD_AI_SPOT_TODAY_PREFETCH_BUDGET=120
# 10-20：一年分點歷史（現股分點動向卡）。問過的股票最多保留 200 檔、硬碟最多 1.5GB（超過從最久沒人問的淘汰）
# 會員第一次問某檔：同步補一年分點的等待上限（秒；0＝不同步補，只補 70 日）
DISCORD_AI_SPOT_YEAR_SYNC_BUDGET=60
# 背景是否把問過的股票補滿一年：0（預設）＝背景只補近 70 日，一年由會員查詢時補；1＝背景也補一年（CPU 會長時間忙碌）
DISCORD_AI_SPOT_YEAR_BACKGROUND=0
# 背景補歷史每小時最多請求數；保留股票數；硬碟上限（bytes）
DISCORD_AI_SPOT_HISTORY_REQUESTS_PER_HOUR=120
DISCORD_AI_SPOT_HISTORY_MAX_STOCKS=200
DISCORD_AI_SPOT_HISTORY_MAX_BYTES=1500000000
# 分點買／賣均價（0＝關閉，表格不顯示均價欄）；明細筆數（60＝問近一季也算得出均價，同樣 1 個請求）
TEST_MONEYDJ_SPOT_COST=1
TEST_MONEYDJ_SPOT_DAYS=60

# 艾斯 AI Discord Bot 環境變數範例（只列名稱與預設值，不要把真實 Secret 提交到 GitHub）

# ===== Discord（必填）=====
DISCORD_BOT_TOKEN=
