DISCORD_AI_QUEUE_LIMIT=20
# 同時在路上的 Gemini 請求數（不再全域排隊）
DISCORD_AI_GEMINI_CONCURRENCY=4
# ===== 會員額度（額度日＝台灣下午 4 點到隔天下午 4 點，和 Gemini 每日額度同步）=====
